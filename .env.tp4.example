# 4x DGX Spark profile (TP4/EP2). Copy to .env.tp4 and edit. Never commit .env.tp4.
# Used by ./start-tp4.sh; the regular .env fallback is also TP4-safe.

# ─── cluster ──────────────────────────────────────────────────────────────────
HEAD_IP=10.0.0.1
WORKER_IPS="10.0.0.2 10.0.0.3 10.0.0.4"
WORKER_HOSTS="spark2 spark3 spark4"
WORKER_USER=zurih
SSH_IDENTITY=$HOME/.ssh/id_ed25519_shared

# ─── fabric (ConnectX-7 RoCE) ─────────────────────────────────────────────────
# Gloo/NCCL TCP bootstrap on the LAN NIC. Data plane prefers RoCE (NCCL_NET=IB).
FABRIC_IFACE=enp1s0f1np1
GLOO_SOCKET_IFNAME=enP7s7
NCCL_SOCKET_IFNAME=enP7s7
IB_HCA=rocep1s0f0,rocep1s0f1
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_P2P_DISABLE=1
NCCL_SHM_DISABLE=1
NCCL_DEBUG=INFO
# NCCL connection buffers live in pinned host RAM, which on GB10 is GPU memory:
# the defaults (4 MiB Simple + 4.69 MiB LL128 + 0.5 MiB LL per connection, 512
# connections) cost 4.7 GiB per node. Decode all-reduces are 61 KB (LL protocol),
# prefill uses Simple; LL128 buys nothing here. Measured: 5.0 GB -> 0.14 GB pinned.
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_PROTO=^LL128
NCCL_MAX_NCHANNELS=8
# Set NCCL_DEBUG=INFO for one boot to see communicator/channel/protocol choices.
NCCL_DEBUG_SUBSYS=INIT,ENV
NCCL_HOST_DIR=/opt/nccl-ringonly

# ─── switchless ring (optional, 4 nodes without a RoCE switch) ────────────────
# A 4-node ring has no direct fabric path between opposite nodes (rank0 <->
# rank2), and RoCE queue pairs do not follow IP routing, so NCCL's Tree/PAT
# transports fail to connect. Setting this to 1:
#   1. injects ring-only NCCL settings into every rank, and
#   2. overlays the patched host NCCL (NCCL_HOST_DIR) onto the container's pip
#      NCCL path (NCCL_PIP_SO) instead of using LD_LIBRARY_PATH, because DeepEP
#      refuses to start when two NCCL runtimes are visible.
# Step 2 needs a NCCL carrying the sparkring switchless-cycle patch; stock NCCL
# silently ignores NCCL_SWITCHLESS_RING_ONLY and still fails on the Tree
# transport. See docs/switchless-ring.md for the patch set and a build recipe.
#NCCL_SWITCHLESS_RING_ONLY=1
#NCCL_HOST_DIR=$HOME/nccl-2.30.7
#NCCL_WORKER_DIR=/opt/patched-nccl  # optional absolute path on every worker
#NCCL_ALGO=Ring
#NCCL_IB_SUBNET_PREFIX_LEN=24
#NCCL_MIN_NCHANNELS=4
#NCCL_MAX_NCHANNELS=4
#NCCL_P2P_LEVEL=SYS
# Four channels keep pinned host RAM low on the tested ring.

# ─── model / image ────────────────────────────────────────────────────────────
MODEL_DIR=$HOME/NewModels/DeepSeek-V4.1-Flash
COMMON_MODEL=/var/tmp/DeepSeek-V4.1-Flash
# Same digest as the Dockerfile FROM: the dev-dsv41 tag moves, the digest does not.
BASE_IMAGE=lmsysorg/sglang:dev-dsv41@sha256:3dbc313030a6ef2c5d7de8ecf48e9aece722694a82182cb618cc82b588816349
IMAGE=dsv41-4x-spark:canary-roce
BUILD_DOCKERFILE=Dockerfile.canary-roce
BUILD_ARGS=
PORT=8888

# ─── weights on the three workers ────────────────────────────────────────────
# TP4 production keeps a real checkpoint copy on every node; no NFS fallback.
WEIGHTS_MODE=local
WORKER_MODEL_DIR=/home/spark/models/DeepSeek-V4.1-Flash
NFS_SHARE=0
NFS_VOLUME=dsv41-weights
NFS_EXPORT_NAME=dsv41-native
NFS_SERVER_IPS="10.0.22.1"
NFS_CLIENTS=10.0.0.2,10.0.0.3,10.0.0.4,10.0.22.0/24

# ─── parallelism (4 Sparks) ──────────────────────────────────────────────────
# TP4/EP2 is the measured production profile; no TP padding is needed
# (DSV41_TP_PAD=0 below).
NNODES=4
TP_SIZE=4
EP_SIZE=2
DIST_PORT=25000

# ─── serving ──────────────────────────────────────────────────────────────────
# NVMe Engram offload is required on Spark (host RAM == GPU unified memory).
OFFLOAD_MODE=nvme
# GB10 UMA safeguard: do not retain multiple CPU shard pages and asynchronous
# H2D copies while the next checkpoint shard is loading. The tested 4-node ring
# uses serial loading on every rank; start.sh leaves it opt-in outside this TP4
# profile so other hardware retains the original loader behaviour.
DSV41_SERIAL_WEIGHT_LOAD=1
# Per-host cache budget, split across the 2 Engram layers and the ranks sharing
# that host. 0 disables it: with the packed local shards a miss is ONE local
# read, and the measured miss rate costs ~145 reads/s against a drive that does
# ~112k IOPS. Host RAM is GPU memory here and rank 0 has ~0.3 GB available, so
# the GiB this used to hold is worth far more as headroom than as hit rate.
DSV41_CACHE_GIB=4
# GB10 NVMe: ~3.5k IOPS at QD=1, ~112k at QD=64. The Engram callback blocks the
# compute stream, so misses are serviced by a pool rather than one at a time.
DSV41_IO_THREADS=96
# Pinning the owned scale rows makes a miss cost one pread instead of two
# (~1.8x on the callback), but it needs ~1 GiB/layer/rank of EAGER host RAM, and
# host RAM here is GPU memory: with weights at ~104 GB the pin raised SGLang's
# "minimum viable" mem-fraction from ~0.940 to 0.9569 and left no KV cache.
# Off until the packed local shard lands, which gets the same single read from
# disk layout instead of RAM.
DSV41_RESIDENT_SCALES=0
DSV41_CACHE_WAYS=16
DSV41_STATS_SECONDS=60
CONTEXT_LENGTH=1048576
# TP4 leaves ~40 GB free per rank, so the fraction is not the binding knob it is
# at TP3. 0.80 buys no memory and costs ~30% prefill time; 0.90 wedges at 900k.
MEM_FRACTION_STATIC=0.80
# Rank 0 pays ~1.3 GiB the workers do not (HTTP server + tokenizer +
# detokenizer) and also serves the checkpoint over NFS. The knob exists to tune
# it separately, but note LOWERING it does not give the head headroom: weights
# cost the same either way, so a smaller fraction only starves the KV pool.
# Measured on this box: 0.9436 is where KV goes negative, and 0.945 still leaves
# only 0.12 GB -- less than the 0.34 GB DSV4 SWA cap. 0.95 is the working value.
HEAD_MEM_FRACTION_STATIC=0.80
MAX_RUNNING_REQUESTS=16
# Base chunk size only; adaptive sizing (below) overrides it per prefix. A fixed
# 2048 wedges a 900k prompt, and a fixed 1024 is safe but 3x slower.
CHUNKED_PREFILL_SIZE=4096
# Size each prefill chunk from the prefix length rather than using the base size.
# The limit is the per-chunk indexer-logits transient, which grows with
# chunk x prefix, so no fixed chunk is safe at both ends. Measured at TP4: fixed
# 2048 runs the box out of memory at 900k, fixed 1024 survives at 3x the time,
# and this sizing completes 900k with room left (floor 3.97 GB vs a 1.5 GB guard).
DSV41_ADAPTIVE_CHUNK=1
DSV41_ADAPTIVE_LOW=409600
DSV41_ADAPTIVE_HIGH=819200
DSV41_ADAPTIVE_FLOOR=1024
# Cap the torch top-k indexer's transient score buffer, in MiB. SGLang sizes a
# scoring step from a module constant that ships at 1 GiB; on a unified-memory
# GB10 that is memory the KV cache cannot have. Measured at TP4 with everything
# else held fixed: 256 moves the 900k memory floor from 2.27 GB to 3.97 GB, with
# the greedy completions byte-identical and no measurable throughput change.
# Unset leaves upstream's 1 GiB -- the adapter is inert without this variable.
DSV41_INDEXER_BUDGET_MIB=256
# Pin the KV pool. Unpinned, SGLang sizes it from whatever is free at load time
# and it swung 326k -> 593k across identical boots, making decode speed a lottery.
# This does NOT free host RAM (torch reserves mem-fraction up front and the pool
# is carved out of that reservation) -- it controls how many pages get touched,
# which is what drives reclaim stalls. The figures below are the TP3 box, where the
# pin is tight; at TP4 the pool is not the binding constraint at all.
# Measured on TP3, tok/s at conc 1 / 4:
#   200k -> 28.6 / 55.4   (pressure 0.00, but too small: batching starves)
#   416k -> 31.9 / 75.6   (pressure 0.00, best measured)
#   593k -> 12.6 / 33.9   (pressure 6.9 median, head thrashing)
# Pinned, SGLang demands exactly this and FAILS if it does not fit -- 400k died
# with "no room ... within the available 0.17 GB". Unpinned it auto-fits, and the
# smallest size it ever chose here was 326k, so the pin must sit below that.
# At TP4, 8M is what measured best with 12 concurrent requests (667k per session);
# what runs the box out at 1M context is the transient prefill buffer, not this.
DSV41_SERIAL_WEIGHT_LOAD=1
MAX_TOTAL_TOKENS=8000000
SPEC_ALGO=DSPARK
DSPARK_BLOCK_SIZE=5
# Profile with sglang.benchmark.dspark_sps_profiler into state/dspark_sps.json;
# until that file exists DSpark runs the verify-all schedule and gains nothing.
DSPARK_SPS_TABLE=/state/dspark_sps.json
DSPARK_STS_TABLE=/state/dspark_sts.json

# ─── engram local shards ──────────────────────────────────────────────────────
# ./start.sh pack repacks each rank's owned Engram rows (weight+scale adjacent)
# onto node-local NVMe: ~68 GiB/node, one read per miss instead of two, and no
# NFS hop on the workers. Serving picks them up automatically when present.
ENGRAM_DIR=$HOME/dsv41-engram
DSV41_PACKED_DIR=/engram
SKIP_PREPARE=1
SKIP_VERIFY=1
SKIP_SMOKE=0
SMOKE_QUICK=1

# ─── kernels (GB10 / SM121) ───────────────────────────────────────────────────
# The 32x32 ue8m0 block-FP8 dense projections only have a Triton kernel unless a
# FlashInfer backend is named, which routes them to the MXFP8 dense kernels.
# --watchdog-timeout covers the CuTe-DSL JIT compile of the b12x kernels on the
# first forward after a boot.
# --sleep-on-idle parks the scheduler when idle instead of spinning a CPU core.
# --min-free-slots-delay 1 disables the admission delayer, which is what makes
# MAX_RUNNING_REQUESTS=8 actually reachable. SGLang treats DSPARK as
# DFlash-family (spec_info.py: is_dflash_family = is_dflash or is_dspark), and
# for that family with max-running-requests >= 8 it auto-enables a threshold of
#   min(4, max(2, (max_running_requests + 5) // 6))
# (srt/managers/min_free_slots_delayer.py), i.e. 2 at 8 requests and 3 at 16.
# New prefills are then held until that many slots are free, so with steady
# arrivals the batch never sustains the configured max -- ~7 of 8, ~13-14 of 16.
# An explicit value wins and <= 1 disables it. Externally reported: +43% c8
# aggregate on a 3-Spark fleet. Not yet measured here. Drop this flag to get the
# batched admissions back if per-admission cost (DSpark's draft prefill pass)
# ever dominates at high concurrency.
EXTRA_SGLANG_ARGS="--fp8-gemm-backend flashinfer_cutlass --watchdog-timeout 1800 --min-free-slots-delay 1 --sleep-on-idle"
# Which FlashInfer MXFP8 kernel serves those projections (adapter/mxfp8_b12x.py):
# b12x is FlashInfer's own SM120/121 choice (16|32-row tiles, ~3x the CUTLASS
# SM120 kernel at decode M); cudnn is the alternative; cutlass restores SGLang's
# default, which measured no faster than Triton (both ~50 ms of a decode step).
DSV41_MXFP8_BACKEND=b12x
# FlashInfer's fused MoE finalize sums the top-k expert outputs with atomic bf16
# adds. The autotuner picks it for the 32-token bucket (17-32 token prefills,
# decode at concurrency 3-4), which made greedy outputs nondeterministic by up to
# ~1 nat on first-token logprobs. Off = separate finalize kernel, ~0.3 ms/step.
SGLANG_FLASHINFER_MOE_FUSED_FINALIZE=0

# Reasoning budget for thinking-mode requests that carry no reasoning_effort.
# SGLang's V4.1 encoder maps low/high/xhigh/max to 25/50/75/100 and defaults to
# "high" = 50; the publisher's encoding/encoding.py says low=50, high=75, max=100
# with default 75. adapter/sitecustomize.py remaps the named tiers to the
# publisher's table; this pins the default as a number so it holds even without
# the remap. Integer 1-100 or low/high/xhigh/max. Per request: OpenAI
# reasoning_effort (a tier, or a 0-0.99 float = budget/100) or
# chat_template_kwargs {"reasoning_effort": N}. Only rendered in thinking mode.
SGLANG_DSV41_REASONING_EFFORT=75

# When a chat request omits max_tokens / max_completion_tokens, fill this in and
# also clamp larger client values. 32768 would have stopped the 714k-token
# racing-animation loop while covering the visual/HTML trials (~15k). 0 restores
# SGLang's fill-the-remaining-context behaviour (1M on TP4). Raise it for long
# thinking-on traces.
DSV41_MAX_NEW_TOKENS=32768

# Decode-side loop abort. --watchdog-timeout only fires when a step hangs; a live
# token stream (VIS-04: 714k tokens of racing-animation HTML) is healthy as far
# as the GPU watchdog is concerned. Finish with stop/repetition after four
# copies of a ≥32-token n-gram, 64 identical tokens, or eight identical decoded
# lines. The 2× EXL3 recipe has no equivalent. 0 disables.
DSV41_LOOP_ABORT=1
DSV41_LOOP_NGRAM=32
DSV41_LOOP_REPEATS=4
DSV41_LOOP_LINE_REPEATS=8

# PyTorch caching allocator mode. The DSV4 prefill allocates a larger indexer-logits
# buffer for every 2048-token chunk (each chunk scores the whole prefix so far); the
# native allocator cannot reuse smaller freed blocks for the next larger request and
# reserved memory grows with the SQUARE of the prompt length (measured: 8 GiB reserved,
# 0 live, after 64 growing steps), which is the 64k-128k prefill OOM on the head.
# expandable_segments coalesces freed space: 0.6 GiB after 128 steps in the same test.
# NOT expandable_segments:True: on the 3-node GB10 fleet it made every prefill of more
# than 64 query tokens return NaN logits (REPORT.md section 17). Untested at TP4.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False

# adapter/prefill_empty_cache.py (in the shared image): after every prefill chunk of a
# sequence at least this long, return PyTorch's unused cached blocks so a long prompt
# costs one chunk's transient instead of the sum over chunks (REPORT.md section 17b).
# The per-chunk indexer buffer is CHUNKED_PREFILL_SIZE x prefix x 4 B per ratio-1 source
# layer, ~14 B x chunk x prefix at the peak across layers: at 1M context a 1024-token
# chunk peaks around 15 GB, against the ~24 GiB per rank that MEM_FRACTION_STATIC=0.80
# leaves outside the static pool (verified: 1M-context needle test passed on TP4). Use
# scripts/verify/memguard.py when ramping new prompt shapes, and drop the chunk to 512
# if the guard fires. 0 disables the hook.
DSV41_PREFILL_EMPTY_CACHE_TOKENS=8192

# ─── TP4 runtime ──────────────────────────────────────────────────────────────
# Memory per rank at TP4: ~77 GiB of MXFP4 experts + FP8 dense weights and a
# ~2.5 GiB draft, so ~40 GB of the 121.7 GiB stays free (vs ~6 GB at TP3). That
# pays for the settings above: the full 1M context, an 8M-token KV pool
# (1,670.75 B/token/rank = 13.4 GB), 8 concurrent requests, 1024-token prefill
# chunks (~15 GB peak indexer transient at 1M), and a 0.80 memory fraction that
# keeps ~24 GiB per rank outside the static pool for that transient. Packed Engram
# shards are named engram-l<layer>-r<rank>of4.bin and can share ENGRAM_DIR with a
# 3-Spark profile. At TP4 every shard holds real weights, so no head padding.
DSV41_TP_PAD=0

# ─── new recipe gates, with the local ring transport retained ────────────────
# The canary-roce image supplies the new SGLang/adapters, but RoCEnante must stay
# off on this physical ring. TP collectives therefore continue through the local
# Ring-only NCCL library and the PEER_HCA mapping managed by spark/config.yaml.
EXTRA_CONTAINER_ENV="DSV41_INDEXER_CHUNKED=1 SPARK_PREFILL_TP_SPLIT=1 SPARK_PREFILL_TP_MIN_CONTEXT=32768 SPARK_PREFILL_TP_MIN_ROWS=1024 SGLANG_DSPARK_FOLDED_SAMPLING=2 DSV41_FAST_LOAD=0 DSV41_FAST_LOAD_TP_SLICE=auto DSV41_AUTOTUNE_KEEP=1 DSV41_SHARED_PAD_K=1 DSV41_HC_FUSED=1 DSV41_PREFILL_SP=1 DSV41_PREFILL_SP_FP8=1 DSV41_L2_PREFETCH=1 DSV41_WO_A_W8=1 DSV41_WO_A_W8_MID=1 DSV41_WO_A_W8_DROP=1 DSV41_DRAFT_HEAD_FP8=1 DSV41_DRAFT_TAU=0.7 DSV41_BLOCK_VERIFY=1 DSV41_FOLDED_FENCE=1 DSV41_ENGRAM_PREFETCH=1 DSV41_VERIFY_CAP=conf:0.1 DSV41_ROUTER_LIVE=1 DSV41_MOE_B12X_NEXT=0 DSV41_MOE_B12X_NEXT_DETERMINISTIC=0 DSV41_REPLICATED_SPLIT=wqkv_a,engram.wkv DSV41_DRAFT_MAIN_PROJ_SPLIT=1 SGLANG_ROCE_ALLREDUCE=0 DSV41_ROCE_GATHER=0"
WORKER_DIR=/home/$WORKER_USER/dsv41-4x-spark
