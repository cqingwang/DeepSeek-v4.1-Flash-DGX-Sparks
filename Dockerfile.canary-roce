# CANARY 2026-09-16: same base image, but the SGLang python tree replaced by the upstream
# dsv4.1 branch at f80c91a4b (2026-09-16 19:45 UTC; carries #39370 mHC/metadata fusion,
# #39653 communication kernels, #39648 top-k, #39646 kernels) with the kernel packages the
# branch pins (sglang-kernel 0.4.7, sgl-deep-gemm 0.2.0; aarch64 wheels from PyPI), plus
# the credited SGLang #41303 safety and #42901 layer-20 bounded-replay backports.
# The credited backport set also includes SGLang #44001's opt-in scheduler gate
# #41259/#45410's fail-closed parallel tokenizer for long native prompts,
# #44751's tool-result image/thinking ordering, #45301's graph-owned padded
# queries, #40424's DP-padding safety, #43448's no-chunk MHC prewarm,
# #45457's request-text/control-token separation and #45762's default-thinking parser parity.
# The tree comes from a GitHub tarball (runtime/sglang-canary/python) because the image's
# git cannot fetch unauthenticated. Mia's SM120 page-split override is re-applied on top of
# the branch's kernel file. Everything else is the production Dockerfile.
# Tag: dsv41-4x-spark:canary
ARG BASE_IMAGE=lmsysorg/sglang:dev-dsv41@sha256:3dbc313030a6ef2c5d7de8ecf48e9aece722694a82182cb618cc82b588816349
ARG FETCH_STAGE=fetch
FROM ${BASE_IMAGE} AS fetch
COPY runtime/sources.manifest runtime/sglang-rocenante.patch runtime/flash_mla_sm120.canary.py /src/runtime/
COPY runtime/patch_*.py /src/runtime/
COPY scripts /src/scripts/
COPY patches /src/patches/
COPY --from=spark-ring / /src/spark-ring/
RUN SPARK_RING_DIR=/src/spark-ring bash /src/scripts/fetch_runtime.sh /fetched b12x b12x-next
RUN bash /src/scripts/fetch-sglang-canary.sh \
 && cp -R /src/runtime/sglang-canary /fetched/sglang-canary

FROM ${BASE_IMAGE} AS fetch_local
COPY runtime/sources.manifest /fetched/sources.manifest
COPY runtime/sglang-canary/python /fetched/sglang-canary/python
COPY runtime/sglang-canary/REF runtime/sglang-canary/PATCHES /fetched/sglang-canary/
COPY runtime/sglang-canary/upstream-tests /fetched/sglang-canary/upstream-tests
COPY runtime/fetched/b12x /fetched/b12x
COPY runtime/fetched/b12x_next /fetched/b12x_next
RUN expected_ref="$(awk '$1 == "sglang-canary" { print $2 }' /fetched/sources.manifest)" \
 && test "$(cat /fetched/sglang-canary/REF)" = "$expected_ref" \
 && test -s /fetched/sglang-canary/PATCHES \
 && grep -q '^41303 ' /fetched/sglang-canary/PATCHES \
 && grep -q '^45804 ' /fetched/sglang-canary/PATCHES

FROM ${FETCH_STAGE} AS fetch_selected
COPY --from=spark-ring /comm/roce_env.py /fetched/b12x/b12x/comm/roce_env.py
COPY --from=spark-ring /comm/roce_ring /fetched/b12x/b12x/comm/roce_ring
COPY --from=spark-ring /comm/roce_env.py /fetched/b12x_next/b12x_next/comm/roce_env.py
FROM ${BASE_IMAGE}
# Same mirror knob as Dockerfile.canary (Saolence, #6): --build-arg PIP_INDEX=<mirror>/simple
ARG PIP_INDEX=https://pypi.org/simple
RUN pip install --no-deps --no-cache-dir -i "$PIP_INDEX" "sglang-kernel==0.4.7" "sgl-deep-gemm==0.2.0"
RUN rm -rf /sgl-workspace/sglang/python
COPY --from=fetch_selected /fetched/sglang-canary/python /sgl-workspace/sglang/python
RUN python3 -c "import sglang, sglang.srt.models.deepseek_v4, sglang.srt.layers.attention.deepseek_v4_backend, sglang.srt.models.deepseek_v4_dspark; print('import ok')"
# RoCEnante overlay (SG17, rhys101) applied to the branch tree with offsets, then adapted to TP4.
# Do not add the upstream two-shot package here: knapcio documents it as switched-fabric-only,
# while this image is built for the managed switchless ring.
COPY runtime/sglang-rocenante.patch runtime/roce_tp4_adapt.py /tmp/
RUN cd /sgl-workspace/sglang && patch -p1 -F3 < /tmp/sglang-rocenante.patch && python3 /tmp/roce_tp4_adapt.py && rm /tmp/sglang-rocenante.patch /tmp/roce_tp4_adapt.py
COPY --from=fetch_selected /fetched/b12x/b12x /opt/b12x/b12x
COPY --from=fetch_selected /fetched/b12x/LICENSE /opt/b12x/LICENSE
RUN PYTHONPATH=/opt/b12x python3 -c "from b12x.comm import roce; print('roce', roce.API_VERSION)"
# b12x main renamed to b12x_next (scripts/fetch_runtime.sh) for adapter/moe_b12x_next.py, beside
# the SG17 b12x that RoCEnante needs; its JIT/tuning cache is B12X_NEXT_COMPILE_CACHE_DIR.
COPY --from=fetch_selected /fetched/b12x_next/b12x_next /opt/b12x_next/b12x_next
COPY --from=fetch_selected /fetched/b12x_next/LICENSE /opt/b12x_next/LICENSE
RUN PYTHONPATH=/opt/b12x:/opt/b12x_next python3 -c "import b12x.comm.roce, b12x_next.moe.fused_moe; print('b12x_next', open('/opt/b12x_next/b12x_next/SOURCE_COMMIT').read().strip())"
# Keep the local API compatibility fix in the RoCE-derived image as well; do not rely on
# an old base layer retaining a previously patched encoding_dsv41.py.
COPY runtime/patch_encoding_dsv41.py /opt/dsv41/runtime/patch_encoding_dsv41.py
RUN python3 /opt/dsv41/runtime/patch_encoding_dsv41.py
COPY runtime/sources.manifest /opt/dsv41/runtime/sources.manifest
COPY runtime/b12x/source-provenance.json /opt/dsv41/runtime/b12x/
COPY --from=spark-ring /roce_ring-provenance.json /opt/dsv41/runtime/b12x/
WORKDIR /opt/dsv41
COPY adapter /opt/dsv41/adapter
RUN g++ -O2 -Wall -Wextra -Werror -std=c++17 -shared -fPIC -pthread \
    -DDSV41_ROW_STORE_DRM adapter/row_store.cpp -o adapter/librow_store.so
COPY runtime/flash_mla_sm120.canary.py /sgl-workspace/sglang/python/sglang/kernels/ops/attention/flash_mla_sm120.py
# Fail the build if either pinned textual-placeholder anchor has drifted.
COPY runtime/patch_encoding_dsv41.py /opt/dsv41/runtime/patch_encoding_dsv41.py
RUN python3 /opt/dsv41/runtime/patch_encoding_dsv41.py
COPY boot.py /opt/dsv41/boot.py
COPY scripts /opt/dsv41/scripts
# #45804 narrows #45762 to native DeepSeek encoders and covers Responses API.
# 将同一份已补丁 runtime 的源码校验和 CPU falsifier 合并为一层，给 overlay2 留出层数预算。
RUN set -eu; \
    python3 /opt/dsv41/scripts/verify_sglang_bounded_replay.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/verify_sglang_layer20_tail.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/verify_sglang_prefill_interval_min_bs.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/verify_sglang_parallel_prompt_encode.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/verify_sglang_dsv41_inline_system.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/verify_sglang_dsv41_tool_images_thinking.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/test_sglang_dsv41_tool_images_thinking.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/verify_sglang_dsv41_padded_query_buffer.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/test_sglang_dsv41_padded_query_buffer.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/verify_sglang_dsv41_dp_padding.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/test_sglang_dsv41_dp_padding.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/verify_sglang_mhc_prewarm_no_chunk.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/test_sglang_mhc_prewarm_no_chunk.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/verify_sglang_dsv41_plain_text.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/verify_sglang_dsv41_reasoning_end.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/verify_sglang_dspark_draft_params.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/verify_sglang_dspark_accept_outputs.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/verify_sglang_dspark_softmax_clamp.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/test_sglang_dspark_softmax_clamp.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/verify_sglang_dspark_param_restage.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/test_sglang_dspark_param_restage.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/verify_sglang_mxfp8_decode_tactics.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/verify_sglang_dsv41_indexer_inplace.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/verify_sglang_dsv41_blocked_kv_dequant.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/test_sglang_dsv41_blocked_kv_dequant.py; \
    python3 /opt/dsv41/scripts/verify_sglang_dsv41_align_indexer_width.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/test_sglang_dsv41_align_indexer_width.py; \
    python3 /opt/dsv41/scripts/verify_sglang_dsv41_thinking_parity.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/test_sglang_dsv41_thinking_parity.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/verify_sglang_dsv41_window_history_src.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/test_sglang_dsv41_window_history_src.py; \
    python3 /opt/dsv41/scripts/verify_sglang_dsv41_fused_window_layout.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/test_sglang_dsv41_fused_window_layout.py; \
    python3 /opt/dsv41/scripts/verify_sglang_dsv41_idle_swa_store.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/test_sglang_dsv41_idle_swa_store.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/verify_sglang_dsv41_draft_metadata_glue.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/test_sglang_dsv41_draft_metadata_glue.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/verify_sglang_greedy_flags_refresh.py /sgl-workspace/sglang/python; \
    python3 /opt/dsv41/scripts/test_sglang_greedy_flags_refresh.py /sgl-workspace/sglang/python
COPY --from=fetch_selected /fetched/sglang-canary/upstream-tests/test_parallel_prompt_encode.py /fetched/sglang-canary/upstream-tests/test_plain_text_encode.py /fetched/sglang-canary/upstream-tests/test_reasoning_parser.py /opt/dsv41/upstream-tests/
RUN set -eu; \
    PYTHONPATH=/sgl-workspace/sglang/python python3 -m pytest -q /opt/dsv41/upstream-tests/test_parallel_prompt_encode.py; \
    PYTHONPATH=/sgl-workspace/sglang/python python3 -m pytest -q /opt/dsv41/upstream-tests/test_plain_text_encode.py; \
    PYTHONPATH=/sgl-workspace/sglang/python python3 /opt/dsv41/scripts/run_sglang_45458_upstream_test.py /opt/dsv41/upstream-tests/test_reasoning_parser.py
COPY tests /opt/dsv41/tests
COPY benchmarks /opt/dsv41/benchmarks
# Packaging tests below also verify patch provenance and both canary build
# recipes. Keep those small source artifacts in the image test context.
COPY README.md Dockerfile Dockerfile.canary Dockerfile.canary-roce .env.tp4.example /opt/dsv41/
COPY patches /opt/dsv41/patches
COPY runtime/*.py /opt/dsv41/runtime/
COPY runtime/b12x /opt/dsv41/runtime/b12x
RUN PYTHONPATH=/opt/dsv41/adapter python3 /opt/dsv41/tests/test_anthropic_thinking.py \
 && CUDA_VISIBLE_DEVICES= PYTHONDONTWRITEBYTECODE=1 python3 -B /opt/dsv41/tests/test_v41_tool_constraint.py \
 && CUDA_VISIBLE_DEVICES= python3 /opt/dsv41/tests/test_swa_bounded_replay_backport.py \
 && python3 /opt/dsv41/tests/test_sglang_layer20_tail_patch.py \
 && python3 /opt/dsv41/tests/test_sglang_prefill_interval_min_bs_patch.py \
 && python3 /opt/dsv41/tests/test_sglang_parallel_prompt_encode_patch.py \
 && python3 /opt/dsv41/tests/test_sglang_dsv41_inline_system_patch.py \
 && python3 /opt/dsv41/tests/test_sglang_dsv41_plain_text_patch.py \
 && python3 /opt/dsv41/tests/test_sglang_dsv41_reasoning_end_patch.py \
 && python3 /opt/dsv41/tests/test_sglang_dspark_draft_params_patch.py \
 && python3 /opt/dsv41/tests/test_sglang_dspark_accept_outputs_patch.py \
 && python3 /opt/dsv41/tests/test_sglang_dspark_softmax_clamp_patch.py \
 && python3 /opt/dsv41/tests/test_sglang_dspark_param_restage_patch.py \
 && python3 /opt/dsv41/tests/test_sglang_mxfp8_decode_tactics_patch.py \
 && python3 /opt/dsv41/tests/test_sglang_dsv41_indexer_inplace_patch.py \
 && python3 /opt/dsv41/tests/test_sglang_dsv41_blocked_kv_dequant_patch.py \
 && python3 /opt/dsv41/tests/test_sglang_dsv41_align_indexer_width_patch.py \
 && python3 /opt/dsv41/tests/test_sglang_dsv41_default_thinking_patch.py \
 && python3 /opt/dsv41/tests/test_sglang_dsv41_thinking_parity_patch.py \
 && python3 /opt/dsv41/tests/test_sglang_dsv41_window_history_src_patch.py \
 && python3 /opt/dsv41/tests/test_sglang_dsv41_fused_window_layout_patch.py \
 && python3 /opt/dsv41/tests/test_sglang_dsv41_idle_swa_store_patch.py \
 && python3 /opt/dsv41/tests/test_sglang_dsv41_draft_metadata_glue_patch.py \
 && python3 /opt/dsv41/tests/test_sglang_greedy_flags_refresh_patch.py \
 && DSV41_PREFILL_BYPASS_SOURCE_ROOT=/sgl-workspace/sglang/python/sglang/srt/managers DSV41_PREFILL_BYPASS_EXPECT=supported PYTHONPATH=/opt/dsv41/adapter python3 /opt/dsv41/tests/test_prefill_bypass.py \
 && PYTHONPATH=/opt/dsv41/adapter python3 /opt/dsv41/tests/test_thinking_alias.py \
 && PYTHONPATH=/opt/dsv41/adapter python3 /opt/dsv41/tests/test_max_new_tokens.py \
 && PYTHONPATH=/opt/dsv41/adapter python3 /opt/dsv41/tests/test_loop_abort.py \
 && PYTHONPATH=/opt/dsv41/adapter python3 /opt/dsv41/tests/test_fast_load_pacing.py \
 && CUDA_VISIBLE_DEVICES= PYTHONPATH=/opt/dsv41/adapter python3 /opt/dsv41/tests/test_fast_load_tp_slice.py \
 && CUDA_VISIBLE_DEVICES= PYTHONPATH=/opt/dsv41/adapter python3 /opt/dsv41/tests/test_prefill_sp.py \
 && CUDA_VISIBLE_DEVICES= PYTHONPATH=/opt/dsv41/adapter python3 /opt/dsv41/tests/test_fast_load_slab.py \
 && CUDA_VISIBLE_DEVICES= PYTHONPATH=/opt/dsv41/adapter python3 /opt/dsv41/tests/test_moe_b12x_next_cpu.py \
 && PYTHONPATH=/opt/dsv41/adapter python3 /opt/dsv41/tests/test_wo_a_w8.py \
 && CUDA_VISIBLE_DEVICES= PYTHONPATH=/opt/dsv41/adapter python3 /opt/dsv41/tests/test_wo_a_input_fp8.py \
 && PYTHONPATH=/opt/dsv41/adapter python3 /opt/dsv41/tests/test_draft_tau.py \
 && PYTHONPATH=/opt/dsv41/adapter python3 /opt/dsv41/tests/test_folded_fence.py \
 && PYTHONPATH=/opt/dsv41/adapter python3 /opt/dsv41/tests/test_draft_head_fp8.py \
 && PYTHONPATH=/opt/dsv41/adapter python3 /opt/dsv41/tests/test_draft_head_fp8_tp4.py \
 && BV_TEST_N=60000 PYTHONPATH=/opt/dsv41/adapter python3 /opt/dsv41/tests/test_block_verify.py \
 && PYTHONPATH=/opt/dsv41/adapter python3 /opt/dsv41/tests/test_block_verify_numerics.py \
 && PYTHONPATH=/opt/dsv41/adapter python3 /opt/dsv41/tests/test_autotune_keep.py \
 && CUDA_VISIBLE_DEVICES= PYTHONPATH=/opt/dsv41/adapter python3 /opt/dsv41/tests/test_replicated_split.py \
 && CUDA_VISIBLE_DEVICES= VC_TEST_N=60000 PYTHONPATH=/opt/dsv41/adapter python3 /opt/dsv41/tests/test_verify_cap.py \
 && CUDA_VISIBLE_DEVICES= python3 /opt/dsv41/tests/test_roce_ring.py \
 && python3 /opt/dsv41/tests/test_local_ring_runtime_scope.py \
 && cd /opt/dsv41/tests \
 && CUDA_VISIBLE_DEVICES= PYTHONPATH=/opt/dsv41/adapter python3 test_indexer_chunked_v3.py /sgl-workspace/sglang/python/sglang/srt/layers/attention/deepseek_v4_backend.py
# SGLANG_RUST_BUILD_MODE=never still probes `cargo --version --verbose`, and rustup can
# hang there for minutes trying to fetch a toolchain (a TP rank stuck before torch
# distributed init). With no reachable dist server the probe fails at once and the
# image processor falls back to PIL.
ENV PYTHONPATH=/opt/dsv41/adapter:/opt/b12x:/opt/b12x_next \
    MODEL_PATH=/models/DeepSeek-V4.1-Flash \
    STATE_PATH=/state OFFLOAD_MODE=nvme DSV41_CACHE_GIB=16 \
    RUSTUP_DIST_SERVER=http://127.0.0.1:1 RUSTUP_UPDATE_ROOT=http://127.0.0.1:1 \
    CARGO_NET_OFFLINE=true
# Every hash-pinned adapter must install on this engine tree (a drift kills the head at boot).
RUN CUDA_VISIBLE_DEVICES= python3 /opt/dsv41/tests/test_adapter_engine_pins.py
EXPOSE 8888
HEALTHCHECK --interval=30s --timeout=30s --start-period=30m --retries=3 \
    CMD ["python3", "-S", "/opt/dsv41/boot.py", "health"]
ENTRYPOINT ["python3", "-u", "/opt/dsv41/boot.py"]
CMD ["run"]
ARG SOURCE_REV=unknown
LABEL com.spark.dsv41.overlay="1" \
      com.spark.dsv41.source-revision="$SOURCE_REV" \
      com.spark.dsv41.base-image="lmsysorg/sglang:dev-dsv41@sha256:3dbc313030a6ef2c5d7de8ecf48e9aece722694a82182cb618cc82b588816349" \
      com.spark.dsv41.sglang-commit="f80c91a4b97e52e17fbcff088aa6b47b6270f6b9" \
      com.spark.dsv41.b12x-commit="a7d7d29b2ef8869086e0ceaa787321f17544e3c9" \
      com.spark.dsv41.roce-ring-commit="f16b5f43208c188c018c43820ccf52955006d1a5"
