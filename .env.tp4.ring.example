# Standalone TP4 ring reference only. The managed four-Spark target reads the
# generated `.env.tp4` block from spark/config.yaml; this file is not a second
# topology or serving-parameter source of truth.
#
# Key deviations from upstream defaults:
#   EP_SIZE=2                 straggler fix: NCCL/step 16.5 -> 10.2 ms [measured]
#   MAX_RUNNING_REQUESTS=12   8 -> 12; with --min-free-slots-delay 1 the 12th slot
#                             actually runs (c12 299 -> 385 tok/s) [measured]
#   MAX_TOTAL_TOKENS=5000000  KV pool; 4M was the upstream value
#   DSV41_SHARED_PAD_K=1      lossless: keeps the shared expert's down_proj K=576
#                             shape eligible for b12x (upstream PR #17)
#   EXTRA_SGLANG_ARGS         + --min-free-slots-delay 1
#   DSV41_CACHE_GIB=1         1 GiB / 16-way [measured]: Engram hit rate 0 -> 99.1%,
#                             c12 +6% (375 -> 399), prefill 100K +10.5%. An earlier
#                             "0 is better" reading was wrong -- packed shards make a
#                             miss one read, but the cache makes it zero reads 99% of
#                             the time. 1 GiB saturates; upstream PR#7's 4 GiB is not
#                             needed. Costs ~2 GB of long-prompt headroom (900K fails,
#                             600K is fine -- see docs/).
#
# Used by ./start-tp4.sh. Weights are node-local on all four machines
# (WEIGHTS_MODE=local); the NFS share machinery is skipped.

# ─── Parent-managed cluster and ring values ───────────────────────────────────
# Query/derive these values through spark/config.yaml -> spark/program.py -> spark/deploy.sh.
# This example intentionally holds no live host addresses, interface/HCA names, GID selectors,
# or per-rank peer maps. Use the parent deployment entry point to create the managed .env block.
# HEAD_IP=<generated from common.spark_nodes>
# WORKER_IPS=<generated in physical common.ring rank order from common.spark_nodes>
# WORKER_HOSTS=<generated in physical common.ring rank order from common.spark_nodes>
# FABRIC_IFACE=<generated from common.ring>
# GLOO_SOCKET_IFNAME=<generated from common.spark_nodes.*.management_if>
# NCCL_SOCKET_IFNAME=<generated from common.spark_nodes.*.management_if>
# IB_HCA=<generated from common.ring.nodes.*.hca_all>
# The managed NCCL build selects ports by peer RoCE GID subnet; it does not consume PEER_HCA_RANK overrides.
# NCCL_IB_GID_INDEX_FORCE=<target-level NCCL policy>

# NCCL policy, GID policy, HCA lists and B12X peer paths come from
# spark/config.yaml. NCCL selects ports by peer RoCE GID subnet; no NCCL peer-HCA override is used.

# General engine env. Physical subnet settings and B12X HCA/path values are generated by deploy.
EXTRA_DOCKER_ENV="TORCH_CUDA_ARCH_LIST=12.1a FLASHINFER_DISABLE_VERSION_CHECK=1 PYTHONFAULTHANDLER=1 HF_HUB_OFFLINE=1 DSV41_SHARED_PAD_K=1 EP_SUPPRESS_NCCL_CHECK=1 SGLANG_RAGGED_VERIFY_MODE=static DSV41_ADAPTIVE_CHUNK=1 DSV41_ADAPTIVE_LOW=409600 DSV41_ADAPTIVE_HIGH=819200 DSV41_ADAPTIVE_FLOOR=1024"

# ─── model / image ────────────────────────────────────────────────────────────
MODEL_DIR=/opt/models/deepseek-ai/DeepSeek-V4.1-Flash-1017
COMMON_MODEL=/var/tmp/DeepSeek-V4.1-Flash
BASE_IMAGE=lmsysorg/sglang:dev-dsv41
IMAGE=lmsysorg/sglang:dsv41
EXPECTED_SHARDS=48

# ─── weights: node-local, no NFS ──────────────────────────────────────────────
WEIGHTS_MODE=local
WORKER_MODEL_DIR=/opt/models/deepseek-ai/DeepSeek-V4.1-Flash-1017
NFS_SHARE=0

# ─── parallelism (4 Sparks) ───────────────────────────────────────────────────
NNODES=4
TP_SIZE=4
EP_SIZE=2
DIST_PORT=25000

# ─── serving: take over the 8899 loopback engine slot ─────────────────────────
# concurrency-proxy (8888) and the NAS LiteLLM gateway stay untouched:
# same port slot, same key, old served name kept as an alias.
PORT=8899
HOST=127.0.0.1
API_KEY=YOUR_API_KEY            # 任意强口令；与门户条目一致
SERVED_MODEL_NAME=deepseek-v4.1-flash,deepseek-v4-flash-vision-exp

OFFLOAD_MODE=nvme
DSV41_CACHE_GIB=1
DSV41_IO_THREADS=96
DSV41_RESIDENT_SCALES=0
DSV41_CACHE_WAYS=16
DSV41_STATS_SECONDS=60
# Ramped to 1M context / 8M KV pool. The KV pool is not the limit here -- the
# long-prefill transient is: the indexer allocates ~14 B x chunk x prefix per
# chunk, so a 2048 chunk at a 900K prefix costs ~26 GB. 0.85 keeps ~16 GB outside
# the static pool for it, and adaptive chunking (below) shrinks the chunk as the
# prefix grows so the transient stays bounded.
CONTEXT_LENGTH=409600
MEM_FRACTION_STATIC=0.85
HEAD_MEM_FRACTION_STATIC=0.85
MAX_RUNNING_REQUESTS=12
CHUNKED_PREFILL_SIZE=2048
# Prefix-aware long-context guardrails; keep these defaults in the standalone
# TP4 template so direct launcher use matches deploy.sh.
DSV41_ADAPTIVE_CHUNK=1
DSV41_ADAPTIVE_LOW=409600
DSV41_ADAPTIVE_HIGH=819200
DSV41_ADAPTIVE_FLOOR=1024
DSV41_INDEXER_BUDGET_MIB=256
MAX_TOTAL_TOKENS=8000000
SPEC_ALGO=DSPARK
DSPARK_BLOCK_SIZE=5
DSPARK_SPS_TABLE=/state/dspark_sps.json
DSPARK_STS_TABLE=/state/dspark_sts.json

# ─── engram local shards (pack after the first stable boot) ──────────────────
RUNTIME_ASSETS=${RUNTIME_ASSETS:-/opt/runtime_assets/deepseek_v4.1_flash_switchless}
ENGRAM_DIR=${ENGRAM_DIR:-$RUNTIME_ASSETS/engram}
DSV41_PACKED_DIR=/engram
SKIP_PREPARE=1
SKIP_VERIFY=1
SKIP_SMOKE=0
SMOKE_QUICK=1

# ─── kernels (GB10 / SM121) ───────────────────────────────────────────────────
# --enable-metrics: required by the RK3588 sparkdash panel token-rate path.
EXTRA_SGLANG_ARGS="--fp8-gemm-backend flashinfer_cutlass --watchdog-timeout 1800 --enable-metrics --min-free-slots-delay 1"
DSV41_MXFP8_BACKEND=b12x
SGLANG_FLASHINFER_MOE_FUSED_FINALIZE=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
DSV41_PREFILL_EMPTY_CACHE_TOKENS=8192

# ─── TP4 runtime ──────────────────────────────────────────────────────────────
# heads=64 / o_groups=8 / draft experts=128 / vocab=129280 all divide by 4:
# no TP padding on this profile.
DSV41_TP_PAD=0
