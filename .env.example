# Copy to .env and edit. Never commit .env.

# ─── cluster (4 Sparks / TP4) ─────────────────────────────────────────────────
HEAD_IP=10.0.0.1
WORKER_IPS="10.0.0.2 10.0.0.3 10.0.0.4"
WORKER_HOSTS="spark2 spark3 spark4"
WORKER_USER=zurih
SSH_IDENTITY=$HOME/.ssh/id_ed25519_shared

# ─── fabric (ConnectX-7 RoCE triangle) ────────────────────────────────────────
# Gloo/NCCL TCP bootstrap on the LAN NIC. Data plane prefers RoCE (NCCL_NET=IB).
FABRIC_IFACE=enp1s0f1np1
GLOO_SOCKET_IFNAME=enP7s7
NCCL_SOCKET_IFNAME=enP7s7
IB_HCA=rocep1s0f0,rocep1s0f1
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_P2P_DISABLE=1
NCCL_SHM_DISABLE=1
NCCL_DEBUG=WARN
# NCCL connection buffers live in pinned host RAM, which on GB10 is GPU memory:
# the defaults (4 MiB Simple + 4.69 MiB LL128 + 0.5 MiB LL per connection, 512
# connections) cost 4.7 GiB per node. Decode all-reduces are 61 KB (LL protocol),
# prefill uses Simple; LL128 buys nothing here. Measured: 5.0 GB -> 0.14 GB pinned.
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_PROTO=^LL128
NCCL_MAX_NCHANNELS=8
# Set NCCL_DEBUG=INFO for one boot to see communicator/channel/protocol choices.
NCCL_DEBUG_SUBSYS=INIT,ENV
NCCL_HOST_DIR=/opt/nccl-ringonly

# ─── model / image ────────────────────────────────────────────────────────────
MODEL_DIR=$HOME/NewModels/DeepSeek-V4.1-Flash
COMMON_MODEL=/var/tmp/DeepSeek-V4.1-Flash
BASE_IMAGE=lmsysorg/sglang:dev-dsv41
IMAGE=dsv41-4x-spark:local
PORT=8888

# ─── weights on the three workers ────────────────────────────────────────────
# TP4 production keeps a real checkpoint copy on every node; no NFS fallback.
WEIGHTS_MODE=local
WORKER_MODEL_DIR=/home/spark/models/DeepSeek-V4.1-Flash
NFS_SHARE=0
NFS_VOLUME=dsv41-weights
NFS_EXPORT_NAME=dsv41-native
NFS_SERVER_IP_1=10.0.22.1
NFS_SERVER_IP_2=10.0.23.1
NFS_CLIENTS=10.0.0.2,10.0.0.3,10.0.0.4,10.0.22.0/24,10.0.23.0/24

# ─── parallelism (4 Sparks) ───────────────────────────────────────────────────
# TP4/EP2 is the measured production profile; EP2 avoids the measured straggler path.
NNODES=4
TP_SIZE=4
EP_SIZE=2
DIST_PORT=25000

# ─── serving ──────────────────────────────────────────────────────────────────
# NVMe Engram offload is required on Spark (host RAM == GPU unified memory).
OFFLOAD_MODE=nvme
# Per-host cache budget: TP4 production uses 1 GiB and 16-way Engram caching.
DSV41_CACHE_GIB=1
# GB10 NVMe: ~3.5k IOPS at QD=1, ~112k at QD=64. The Engram callback blocks the
# compute stream, so misses are serviced by a pool rather than one at a time.
DSV41_IO_THREADS=96
# Pinning the owned scale rows makes a miss cost one pread instead of two
# (~1.8x on the callback), but it needs ~1 GiB/layer/rank of EAGER host RAM, and
# host RAM here is GPU memory: with weights at ~104 GB the pin raised SGLang's
# "minimum viable" mem-fraction from ~0.940 to 0.9569 and left no KV cache.
# Off until the packed local shard lands, which gets the same single read from
# disk layout instead of RAM.
DSV41_RESIDENT_SCALES=0
DSV41_CACHE_WAYS=16
DSV41_STATS_SECONDS=60
# Per-request limit and TP4 production admission budget.
CONTEXT_LENGTH=1048576
MEM_FRACTION_STATIC=0.85
# Rank 0 pays ~1.3 GiB the workers do not (HTTP server + tokenizer +
# detokenizer) and also serves the checkpoint over NFS. The knob exists to tune
# it separately, but note LOWERING it does not give the head headroom: weights
# cost the same either way, so a smaller fraction only starves the KV pool.
# Measured on this box: 0.9436 is where KV goes negative, and 0.945 still leaves
# only 0.12 GB -- less than the 0.34 GB DSV4 SWA cap. 0.95 is the working value.
HEAD_MEM_FRACTION_STATIC=0.85
MAX_RUNNING_REQUESTS=12
# 2048 is the TP4 production chunk; reduce only after a measured long-prefill failure.
CHUNKED_PREFILL_SIZE=2048
# Long-context TP4 fallback: bound the prefix-dependent indexer transient while
# keeping the short-prompt chunk at the production size.
DSV41_ADAPTIVE_CHUNK=1
DSV41_ADAPTIVE_LOW=409600
DSV41_ADAPTIVE_HIGH=819200
DSV41_ADAPTIVE_FLOOR=1024
DSV41_INDEXER_BUDGET_MIB=256
# Pin the KV pool. Unpinned, SGLang sizes it from whatever is free at load time
# and it swung 326k -> 593k across identical boots, making decode speed a lottery.
# This does NOT free host RAM (torch reserves mem-fraction up front and the pool
# is carved out of that reservation) -- it controls how many pages get touched,
# which is what drives reclaim stalls. Measured on this box, tok/s at conc 1 / 4:
#   200k -> 28.6 / 55.4   (pressure 0.00, but too small: batching starves)
#   416k -> 31.9 / 75.6   (pressure 0.00, best measured)
#   593k -> 12.6 / 33.9   (pressure 6.9 median, head thrashing)
# Pinned, SGLang demands exactly this and FAILS if it does not fit -- 400k died
# with "no room ... within the available 0.17 GB". Unpinned it auto-fits, and the
# smallest size it ever chose here was 326k, so the pin must sit below that.
MAX_TOTAL_TOKENS=8000000
SPEC_ALGO=DSPARK
DSPARK_BLOCK_SIZE=5
# Profile with sglang.benchmark.dspark_sps_profiler into state/dspark_sps.json;
# until that file exists DSpark runs the verify-all schedule and gains nothing.
DSPARK_SPS_TABLE=/state/dspark_sps.json
DSPARK_STS_TABLE=/state/dspark_sts.json

# ─── engram local shards ──────────────────────────────────────────────────────
# ./start.sh pack repacks each rank's owned Engram rows (weight+scale adjacent)
# onto node-local NVMe: ~68 GiB/node, one read per miss instead of two, and no
# NFS hop on the workers. Serving picks them up automatically when present.
ENGRAM_DIR=$HOME/dsv41-engram
DSV41_PACKED_DIR=/engram
SKIP_PREPARE=1
SKIP_VERIFY=1
SKIP_SMOKE=0
SMOKE_QUICK=1

# ─── kernels (GB10 / SM121) ───────────────────────────────────────────────────
# The 32x32 ue8m0 block-FP8 dense projections only have a Triton kernel unless a
# FlashInfer backend is named, which routes them to the MXFP8 dense kernels.
# --watchdog-timeout covers the CuTe-DSL JIT compile of the b12x kernels on the
# first forward after a boot.
EXTRA_SGLANG_ARGS="--fp8-gemm-backend flashinfer_cutlass --watchdog-timeout 1800"
# Which FlashInfer MXFP8 kernel serves those projections (adapter/mxfp8_b12x.py):
# b12x is FlashInfer's own SM120/121 choice (16|32-row tiles, ~3x the CUTLASS
# SM120 kernel at decode M); cudnn is the alternative; cutlass restores SGLang's
# default, which measured no faster than Triton (both ~50 ms of a decode step).
DSV41_MXFP8_BACKEND=b12x
# FlashInfer's fused MoE finalize sums the top-k expert outputs with atomic bf16
# adds. The autotuner picks it for the 32-token bucket (17-32 token prefills,
# decode at concurrency 3-4), which made greedy outputs nondeterministic by up to
# ~1 nat on first-token logprobs. Off = separate finalize kernel, ~0.3 ms/step.
SGLANG_FLASHINFER_MOE_FUSED_FINALIZE=0

# PyTorch caching allocator mode. NEVER set expandable_segments:True on this stack:
# with it, every prefill of more than 64 query tokens (a prompt of 65-~4000 tokens, or
# any prefill batch of 3+ short requests) returns NaN logits -> garbage text at
# temperature 0 and a scheduler crash ("probability tensor contains inf/nan") when
# sampling. Bisected 2026-09-11 over five boots (chunk size, context length and the
# warm-up were all ruled out); see logs/profile-2026-09-10/REPORT.md section 17.
# The native allocator does fragment on long prompts (REPORT.md section 15), which is
# why CONTEXT_LENGTH is capped below; expandable_segments:False is the explicit native mode.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False

# adapter/prefill_empty_cache.py: after every prefill chunk of a sequence at least this
# long, return PyTorch's unused cached blocks to the driver, so a long prompt costs one
# chunk's transient instead of the sum over chunks (the native allocator cannot reuse
# the previous chunk's smaller indexer-logits buffer). Measured 2026-09-11 on the head:
# without it a 34k prompt kept 1-1.5 GB and 64k ran out of memory; with it 100k prompts
# complete and the memory comes back after each. 0 disables the hook.
DSV41_PREFILL_EMPTY_CACHE_TOKENS=8192
DSV41_TP_PAD=0
